{
    "version": 2,
    "outputDirectory": "dist/public",
    "builds": [
        {
            "src": "api/index.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": ["shared/**", "backend/**"]
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    },
    "functions": {
        "backend/server.ts": {
            "maxDuration": 60,
            "memory": 1024
        }
    }
}
