{
    "builds": [
        {
            "src": "backend/server.ts",
            "use": "@vercel/node",
            "config": {
                "nodeVersion": "24.x"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/server.ts"
        },
        {
            "src": "/(.*)",
            "dest": "backend/server.ts"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    },
    "functions": {
        "backend/server.ts": {
            "maxDuration": 60,
            "memory": 1024
        }
    }
}
